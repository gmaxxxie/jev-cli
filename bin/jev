#!/usr/bin/env python3
"""
jev — TypeSafe Jev System One 决策模型 CLI（官方直连 / OpenRouter / NewAPI 网关）

三种问题类型（wire 格式）：
  noul    二值判断，返回 P(true) ∈ [0,1]；可选 criteria: {"true": ..., "false": ...}（两键都带）
  choice  从选项里选一个；criteria 为 {key: 描述} 有序对象
  score   有序评分（2-10 级）；criteria 为从低到高的字符串列表，可带 {"label","description"}

用法示例：
  # 最简单：二值判断（默认 noul）
  jev "数据库主节点 CPU 95%" -q urgent:需要立即处理吗?

  # noul + 两侧描述（JSON 完整控制）
  jev "payout 连续失败 3 次" -q '{"urgent":{"type":"noul",\
    "instructions":"This is urgent",\
    "criteria":{"true":"需立即介入","false":"可稍后处理"}}}'

  # choice：从选项里选（criteria 对象，顺序即模型所见顺序）
  jev "请求进入路由层" -q '{"region":{"type":"choice",\
    "instructions":"select region",\
    "criteria":{"us-east":"美东","eu-west":"欧洲","ap-east":"亚太"}}}'

  # score：有序评分（2-10 级，从低到高）
  jev "客户工单语气激烈" -q '{"anger":{"type":"score",\
    "instructions":"anger level",\
    "criteria":["平静","有些不满","明显生气","威胁要取消"]}}'

  # 从文件读 state
  jev @state.txt -q ok:一切正常吗?

API 网关（TypeSafe 官方直连 / OpenRouter / NewAPI，可手动切换）：
  官方直连与 OpenRouter 模型与价格相同（$0.042/1M input，output 免费），只是网关不同。
  默认走官方直连；需要 OpenRouter 或自建 NewAPI 网关时手动切。

    jev --status              # 看当前走哪个网关
    jev --use openrouter      # 切到 OpenRouter（经 OpenRouter 转发）
    jev --use newapi          # 切到 NewAPI Jev 网关（http://127.0.0.1:3000）
    jev --use official        # 切回 TypeSafe 官方直连（api.typesafe.ai）

  优先级（高 → 低）：命令行 flag > 环境变量 > ~/.pi/agent/jev-gateway.json > 默认 official
    -g/--gateway  JEV_GATEWAY     显式指定本次调用的网关（official | openrouter | newapi）
    -e/--endpoint JEV_ENDPOINT    显式指定端点
    -m/--model    JEV_MODEL       显式指定模型

API Key 来源（按优先级）：
  1. --key / JEV_API_KEY
  2. 按网关自动选：
     openrouter → OPENROUTER_API_KEY → ~/.pi/agent/auth.json 的 openrouter.key
     official   → TYPESAFE_API_KEY   → ~/.pi/agent/pi-typesafe/auth.json 的 apiKey
     newapi     → ~/.pi/agent/auth.json 的 new-api.key（无专用环境变量，用 JEV_API_KEY）
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

GATEWAY_PRESETS = {
    "openrouter": {
        "endpoint": "https://openrouter.ai/api/alpha/decisions",
        "model": "typesafe/jev-1.13",
        "label": "OpenRouter Decisions（经 OpenRouter 转发）",
    },
    "official": {
        "endpoint": "https://api.typesafe.ai/v1/systemone",
        "model": "jev-latest",
        "label": "TypeSafe 官方直连",
        "models_path": "/v1/models",
        "model_prefix": "jev-",
    },
    "newapi": {
        "endpoint": "http://127.0.0.1:3000/typesafe/v1/systemone",
        "model": "jev-1.13.0",
        "label": "NewAPI Jev 网关（http://127.0.0.1:3000）",
        "probe_url": "http://127.0.0.1:3000/v1/models",
        "model_prefix": "jev-",
    },
}
DEFAULT_GATEWAY = "official"

# 兼容旧名：默认网关的端点/模型
DEFAULT_ENDPOINT = GATEWAY_PRESETS[DEFAULT_GATEWAY]["endpoint"]
DEFAULT_MODEL = GATEWAY_PRESETS[DEFAULT_GATEWAY]["model"]

AUTH_JSON = os.path.expanduser("~/.pi/agent/auth.json")
TYPESAFE_AUTH_JSON = os.path.expanduser("~/.pi/agent/pi-typesafe/auth.json")
GATEWAY_CONFIG = os.path.expanduser("~/.pi/agent/jev-gateway.json")
JEV_CONFIG = os.path.expanduser("~/.pi/agent/jev-config.json")

VALID_TYPES = ("noul", "choice", "score")

# 缺 key 时各网关可操作的配置位置（--status / --use 提示用）。
KEY_HINTS = {
    "official": f"--key / JEV_API_KEY / TYPESAFE_API_KEY，或 {TYPESAFE_AUTH_JSON} 的 apiKey",
    "openrouter": f"--key / JEV_API_KEY / OPENROUTER_API_KEY，或 {AUTH_JSON} 的 openrouter.key",
    "newapi": f"--key / JEV_API_KEY，或 {AUTH_JSON} 的 new-api.key",
}

# 计价：官方直连与 OpenRouter 同价 $0.042 / 1M input tokens，output 免费。
# NewAPI 网关的计费由该网关自己决定，此处不推测（无 cost 时按同一单价估算）。
USD_PER_MTOK = 0.042


def resolve_gateway(explicit=None):
    """flag > JEV_GATEWAY > jev-gateway.json > 默认 official"""
    g = explicit or os.environ.get("JEV_GATEWAY")
    if not g:
        try:
            with open(GATEWAY_CONFIG, encoding="utf-8") as f:
                g = (json.load(f) or {}).get("gateway")
        except FileNotFoundError:
            pass
        except (json.JSONDecodeError, OSError) as e:
            raise SystemExit(f"读取 {GATEWAY_CONFIG} 失败: {e}") from e
    g = (g or DEFAULT_GATEWAY).strip().lower()
    if g not in GATEWAY_PRESETS:
        raise SystemExit(
            f"未知网关 {g!r}；可选：{', '.join(GATEWAY_PRESETS)}"
        )
    return g


def resolve_endpoint(explicit, gateway):
    return explicit or os.environ.get("JEV_ENDPOINT") or GATEWAY_PRESETS[gateway]["endpoint"]


def resolve_model(explicit, gateway):
    return explicit or os.environ.get("JEV_MODEL") or GATEWAY_PRESETS[gateway]["model"]


def _read_auth(path, pick, hint):
    try:
        with open(path, encoding="utf-8") as f:
            key = pick(json.load(f))
    except FileNotFoundError:
        key = None
    if key:
        return key
    raise SystemExit(f"未找到 {hint}")


def resolve_api_key(explicit=None, gateway=DEFAULT_GATEWAY):
    if explicit:
        return explicit
    common = os.environ.get("JEV_API_KEY")
    if common:
        return common
    if gateway == "official":
        env = os.environ.get("TYPESAFE_API_KEY")
        if env:
            return env
        return _read_auth(
            TYPESAFE_AUTH_JSON,
            lambda a: a.get("apiKey"),
            f"官方 TypeSafe API key：请用 --key / JEV_API_KEY / TYPESAFE_API_KEY，"
            f"或在 {TYPESAFE_AUTH_JSON} 里配置 apiKey（pi 里跑 /typesafe login）",
        )
    if gateway == "newapi":
        return _read_auth(
            AUTH_JSON,
            lambda a: (a.get("new-api") or {}).get("key"),
            f"NewAPI Jev key：请用 --key / JEV_API_KEY，"
            f"或在 {AUTH_JSON} 里配置 new-api.key",
        )
    env = os.environ.get("OPENROUTER_API_KEY")
    if env:
        return env
    return _read_auth(
        AUTH_JSON,
        lambda a: (a.get("openrouter") or {}).get("key"),
        f"OpenRouter API key：请用 --key / JEV_API_KEY / OPENROUTER_API_KEY，"
        f"或在 {AUTH_JSON} 里配置 openrouter.key",
    )


def parse_questions(specs):
    """解析 -q 参数。

    两种形式：
      1. JSON：  -q '{"urgent": {"type": "noul", "instructions": "...", \
                  "criteria": {"true": "...", "false": "..."}}}'
         （完整控制 wire 格式，推荐 choice/score）
      2. 缩写：  -q name:instructions   （= noul，最常见的二值判断）
    """
    questions = {}
    for spec in specs:
        s = spec.strip()
        if s.startswith("{"):
            try:
                obj = json.loads(s)
            except json.JSONDecodeError as e:
                raise SystemExit(f"JSON 解析失败: {e}") from e
            if not isinstance(obj, dict):
                raise SystemExit(f"JSON 必须是对象: {spec}")
            for name, q in obj.items():
                if not isinstance(q, dict) or "type" not in q:
                    raise SystemExit(f"问题 {name} 缺少 type 字段: {spec}")
                # OpenRouter 的 schema 里 instructions 必填，缺省给空串
                q.setdefault("instructions", "")
                questions[name] = q
            continue
        # 缩写: name:instructions → noul
        head, sep, rest = s.partition(":")
        if not sep or not head.strip() or not rest.strip():
            raise SystemExit(f"问题格式错误（应为 name:instructions 或 JSON）: {spec}")
        questions[head.strip()] = {"type": "noul", "instructions": rest.strip()}
    return questions


def call_decisions(state, questions, model, endpoint, api_key, timeout):
    payload = {"model": model, "state": state, "questions": questions}
    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": "Bearer " + api_key,
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")[:2000]
        raise SystemExit(f"HTTP {e.code}: {body}") from e


def _read_jev_config_model():
    """~/.pi/agent/jev-config.json 的 model（jev-cli 扩展写的，会以 -m 压过网关预设）。"""
    try:
        with open(JEV_CONFIG, encoding="utf-8") as f:
            m = (json.load(f) or {}).get("model")
        return m.strip() if isinstance(m, str) and m.strip() else None
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def model_gateway_conflict(model, gateway):
    """模型名是否属于另一条网关（各网关命名空间不通用）。

    OpenRouter 用 `typesafe/jev-1.13`；官方直连与 NewAPI 网关只认 `jev-…`
    （如 jev-latest / jev-preview / jev-1.13.0）。跨网关传模型名会被 API 以
    400 Unknown model 拒掉，所以提前拦下来，给出可操作的提示。
    """
    if not model:
        return None
    if gateway == "official":
        if model.startswith("typesafe/"):
            return (f"模型 {model!r} 是 OpenRouter 的命名（typesafe/…），官方直连不认；"
                    f"用 jev-latest / jev-preview / jev-1.13.0，或切回 -g openrouter")
        prefix = GATEWAY_PRESETS["official"].get("model_prefix", "jev-")
        if not model.startswith(prefix):
            return (f"模型 {model!r} 看起来不是官方 System One 模型（应形如 {prefix}…）；"
                    f"可用 jev-latest / jev-preview / jev-1.13.0")
        return None
    if gateway == "openrouter":
        if model.startswith("jev-"):
            return (f"模型 {model!r} 是官方直连/NewAPI 的命名，OpenRouter 不认；"
                    f"用 typesafe/jev-1.13，或切到 -g official")
        if not model.startswith("typesafe/"):
            return (f"模型 {model!r} 看起来不是 OpenRouter 上的 Jev（应形如 typesafe/…）")
        return None
    # newapi：Jev 网关自己选路，模型名沿用官方命名（jev-…），但不接受 OpenRouter 的 typesafe/…
    if model.startswith("typesafe/"):
        return (f"模型 {model!r} 是 OpenRouter 的命名（typesafe/…），NewAPI 网关不认；"
                f"用 jev-1.13.0，或切回 -g openrouter")
    prefix = GATEWAY_PRESETS["newapi"].get("model_prefix", "jev-")
    if not model.startswith(prefix):
        return (f"模型 {model!r} 看起来不是 Jev 模型（应形如 {prefix}…）；"
                f"NewAPI 网关默认用 {GATEWAY_PRESETS['newapi']['model']}")
    return None


def warn_if_overridden(gateway, endpoint, model, explicit_model, explicit_endpoint):
    """-m/-e 或 jev-config.json 压过网关预设时，在 stderr 提示（不阻断）。"""
    if explicit_endpoint or os.environ.get("JEV_ENDPOINT"):
        preset = GATEWAY_PRESETS[gateway]["endpoint"]
        if endpoint != preset:
            print(f"[jev] 注意：端点被显式覆盖为 {endpoint}（网关 {gateway} 的预设是 {preset}）",
                  file=sys.stderr)
    source = None
    if explicit_model:
        source = "-m"
    elif os.environ.get("JEV_MODEL"):
        source = "JEV_MODEL"
    elif model != GATEWAY_PRESETS[gateway]["model"] and _read_jev_config_model() == model:
        source = JEV_CONFIG
    if source:
        preset = GATEWAY_PRESETS[gateway]["model"]
        if model != preset:
            print(f"[jev] 注意：模型被 {source} 覆盖为 {model}（网关 {gateway} 的预设是 {preset}）；"
                  f"跨网关的模型名不通用，`jev --use` 可能因此不生效", file=sys.stderr)
            conflict = model_gateway_conflict(model, gateway)
            if conflict:
                print(f"[jev] 警告：{conflict}", file=sys.stderr)


def _key_available(gateway):
    """key 是否存在（不打印 key 本身）。"""
    try:
        resolve_api_key(None, gateway)
        return True
    except SystemExit:
        return False


def probe(gateway):
    """活验证：走一次免费的 GET 拿模型列表，确认端点可达 + key 真的有效。

    返回 (ok, 详情文本, 模型名列表)。官方直连用 /v1/models；
    OpenRouter 用 /api/v1/key（返回 key 的用量，不产生模型调用）；
    NewAPI 网关用其 /v1/models。
    """
    key = resolve_api_key(None, gateway)
    if gateway == "official":
        url = "https://api.typesafe.ai" + GATEWAY_PRESETS["official"]["models_path"]
    elif gateway == "openrouter":
        url = "https://openrouter.ai/api/v1/key"
    else:
        url = GATEWAY_PRESETS["newapi"]["probe_url"]
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + key}, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")[:300]
        return False, f"HTTP {e.code}: {body}", []
    except (urllib.error.URLError, OSError) as e:
        return False, f"连接失败: {e}", []
    if gateway == "official":
        names = [m.get("name") for m in (data.get("models") or [])
                 if isinstance(m, dict) and m.get("name")]
        return True, "key 有效，端点可达", names
    if gateway == "newapi":
        # OpenAI 风格的 {"data": [{"id": ...}]}；兼容 {"models": [{"name": ...}]}
        entries = data.get("data")
        if not isinstance(entries, list):
            entries = data.get("models")
        names = [m.get("id") or m.get("name") for m in (entries or [])
                 if isinstance(m, dict) and (m.get("id") or m.get("name"))]
        # 该网关的 /v1/models 会列出全部模型，只报本网关的 Jev 模型（否则刷屏）
        prefix = GATEWAY_PRESETS["newapi"].get("model_prefix")
        if prefix:
            names = [n for n in names if n.startswith(prefix)]
        return True, "key 有效，端点可达", names
    d = data.get("data") or {}
    used = d.get("usage")
    label = d.get("label")
    detail = "key 有效，端点可达"
    if used is not None:
        detail += f"；累计用量 ${used}"
    if label:
        detail += f"（{label}）"
    return True, detail, []


def _describe(gateway, check=False):
    """返回 (文本, 是否通过)。check 模式下 key 无效算不通过（供脚本判定退出码）。"""
    p = GATEWAY_PRESETS[gateway]
    lines = [f"网关:   {gateway}  ({p['label']})",
             f"端点:   {resolve_endpoint(None, gateway)}",
             f"模型:   {resolve_model(None, gateway)}"]
    if not _key_available(gateway):
        lines.append(f"key:    缺失（{KEY_HINTS[gateway]}）")
        return "\n".join(lines), not check
    if not check:
        lines.append("key:    已就绪（仅检查是否存在；--check 可做活验证）")
        return "\n".join(lines), True
    ok, detail, names = probe(gateway)
    lines.append(f"key:    {'✓ ' if ok else '✗ '}{detail}")
    if names:
        lines.append("可用模型: " + ", ".join(names))
    return "\n".join(lines), ok


def do_switch(gateway):
    g = (gateway or "").strip().lower()
    if g not in GATEWAY_PRESETS:
        raise SystemExit(f"未知网关 {gateway!r}；可选：{', '.join(GATEWAY_PRESETS)}")
    os.makedirs(os.path.dirname(GATEWAY_CONFIG), exist_ok=True)
    tmp = GATEWAY_CONFIG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"gateway": g}, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, GATEWAY_CONFIG)
    print(f"已切换默认网关 → {g}\n")
    print(_describe(g)[0])
    if not _key_available(g):
        print("\n提示：该网关缺 key，调用会失败。")
        if g == "official":
            print("  pi 里跑 /typesafe login，或设置 TYPESAFE_API_KEY")
        elif g == "openrouter":
            print("  设置 OPENROUTER_API_KEY，或配置 ~/.pi/agent/auth.json 的 openrouter.key")
        else:
            print("  设置 JEV_API_KEY，或配置 ~/.pi/agent/auth.json 的 new-api.key")
    print(f"\n配置写入 {GATEWAY_CONFIG}（可用 JEV_GATEWAY 环境变量临时覆盖）")
    return 0


def do_status(check=False, explicit_gateway=None):
    persisted = None
    try:
        with open(GATEWAY_CONFIG, encoding="utf-8") as f:
            persisted = (json.load(f) or {}).get("gateway")
    except FileNotFoundError:
        pass
    except (json.JSONDecodeError, OSError) as e:
        print(f"（{GATEWAY_CONFIG} 读取失败: {e}）", file=sys.stderr)
    print(f"配置文件: {GATEWAY_CONFIG} → {persisted or '（不存在）'}")
    if explicit_gateway:
        print(f"命令行: -g {explicit_gateway}  ← 覆盖配置文件")
    for env_name in ("JEV_GATEWAY", "JEV_ENDPOINT", "JEV_MODEL"):
        if os.environ.get(env_name):
            print(f"环境变量: {env_name}={os.environ[env_name]}  ← 覆盖配置文件")
    cfg_model = _read_jev_config_model()
    if cfg_model:
        print(f"扩展配置: {JEV_CONFIG} → model={cfg_model}  ← 会以 -m 压过网关预设")
    print()
    gateway = resolve_gateway(explicit_gateway)
    text, passed = _describe(gateway, check=check)
    print(text)
    conflict_here = False
    if cfg_model:
        conflict = model_gateway_conflict(cfg_model, gateway)
        if conflict:
            print(f"\n⚠ 冲突：{conflict}")
            conflict_here = True
    # 退出码：--check 未通过、或模型与网关冲突 → 非 0，方便脚本/CI 判定
    return 0 if (passed and not conflict_here) else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("state", nargs="?", help="程序状态描述；以 @ 开头则从文件读取")
    ap.add_argument("-q", "--question", action="append", default=[],
                    help="name:type:instructions[...]，可多次（type: noul/choice/score）")
    ap.add_argument("-m", "--model", default=None,
                    help="模型 ID（默认随网关：official=jev-latest，openrouter=typesafe/jev-1.13，"
                         "newapi=jev-1.13.0）")
    ap.add_argument("-e", "--endpoint", default=None, help="端点（默认随网关）")
    ap.add_argument("-g", "--gateway", default=None,
                    help=f"网关：{' | '.join(GATEWAY_PRESETS)}（默认 official；读 {GATEWAY_CONFIG} 或 JEV_GATEWAY）")
    ap.add_argument("--key", help="API key（默认按网关自动解析）")
    ap.add_argument("--use", metavar="GATEWAY",
                    help=f"切换默认网关并持久化到 {GATEWAY_CONFIG}，然后退出")
    ap.add_argument("--status", action="store_true", help="显示当前网关/端点/模型/key 状态，然后退出")
    ap.add_argument("--check", action="store_true",
                    help="配合 --status：走一次免费 GET 做活验证（key 是否真有效 + 可用模型列表）")
    ap.add_argument("-t", "--timeout", type=int, default=60)
    ap.add_argument("-j", "--json", action="store_true", help="输出原始 JSON（含 usage）")
    args = ap.parse_args()

    if args.use:
        return do_switch(args.use)
    if args.status or args.check:
        return do_status(check=args.check, explicit_gateway=args.gateway)

    gateway = resolve_gateway(args.gateway)
    endpoint = resolve_endpoint(args.endpoint, gateway)
    model = resolve_model(args.model, gateway)
    conflict = model_gateway_conflict(model, gateway)
    if conflict and (args.model or os.environ.get("JEV_MODEL")):
        raise SystemExit(f"模型/网关不匹配：{conflict}")
    warn_if_overridden(gateway, endpoint, model, args.model, args.endpoint)
    if args.state is None:
        print("（从 stdin 读取 state，Ctrl-D 结束）", file=sys.stderr)
        state = sys.stdin.read().strip()
    elif args.state.startswith("@"):
        with open(args.state[1:], encoding="utf-8") as f:
            state = f.read().strip()
    else:
        state = args.state.strip()
    if not state:
        raise SystemExit("state 不能为空")

    questions = parse_questions(args.question)
    if not questions:
        questions = {
            "is_urgent": {
                "type": "noul",
                "instructions": "Does this situation require immediate human attention?",
                "criteria": {"true": "Yes, act now", "false": "No, can wait"},
            }
        }

    api_key = resolve_api_key(args.key, gateway)
    result = call_decisions(state=state, questions=questions, model=model,
                            endpoint=endpoint, api_key=api_key, timeout=args.timeout)

    if args.json:
        # stdout 保持纯 JSON（调用方只解析 stdout）；网关信息走 stderr。
        print(f"[jev] 网关: {gateway}  端点: {endpoint}  模型: {model}", file=sys.stderr)
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0

    print("模型: %s  provider: %s  网关: %s"
          % (result.get("model"), result.get("provider") or "typesafe", gateway))
    for name, ans in result.get("answers", {}).items():
        qtype = ans.get("type")
        print("- %s (%s):" % (name, qtype), end=" ")
        if qtype == "noul":
            v = ans.get("noul")
            print("%.2f  (阈值 0.5 → %s)" % (v, "真" if v >= 0.5 else "假"))
        elif qtype == "choice":
            print(ans.get("choice"))
        elif qtype == "score":
            print(ans.get("score"))
        else:
            print(json.dumps(ans, ensure_ascii=False))
    u = result.get("usage") or {}
    if u:
        # 官方直连不返回 cost（output 免费，按 $0.042/1M input 自算）；OpenRouter 会直接给。
        cost = u.get("cost")
        if cost is None and u.get("input_tokens") is not None:
            cost = u["input_tokens"] / 1_000_000 * USD_PER_MTOK
            cost_note = "（按 $%.3f/1M input 估算）" % USD_PER_MTOK
        else:
            cost_note = ""
        print("usage: input=%s output=%s cost=$%.6f%s"
              % (u.get("input_tokens"), u.get("output_tokens"), cost or 0, cost_note))


if __name__ == "__main__":
    sys.exit(main())
